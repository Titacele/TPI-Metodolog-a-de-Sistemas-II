digraph G {
  rankdir=LR; bgcolor="white"; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#f2f2f2", color="#555555", fontname="Helvetica", fontsize=11];
  edge [color="#555555", fontname="Helvetica", fontsize=9];
  label="Versión inicial (estado-inicial)"; labelloc=t; fontsize=14;
  main [label="main.py\nmenú + input()\n(recorre g.estudiantes)"];
  gestor [label="GestorSolicitudes  (325 líneas)\n─────────────────────\nvalidación de datos\ncálculo de prioridad (if/elif)\ntransiciones de estado (if anidados)\nbúsquedas y reporte\nprint() de resultados y errores\nopen()/json.dump × 4\nglobal ARCHIVO, contador", fillcolor="#fde2e2", color="#b33a3a"];
  json [label="datos/solicitudes.json", shape=cylinder, fillcolor="#ffffff"];
